{
  "name": "angular-material-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives AI coding assistants real-time, structured access to Angular Material component APIs, composition patterns, theming, and schematics.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "angular-material-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "angular",
    "angular-material"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^4.1.10"
  }
}
