{
  "name": "angular-material-mcp",
  "version": "1.0.0",
  "description": "MCP server that gives AI coding assistants real-time, structured access to Angular Material component APIs, composition patterns, theming, and schematics.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "angular-material-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlakamraju/angular-material-mcp.git"
  },
  "homepage": "https://github.com/rlakamraju/angular-material-mcp#readme",
  "bugs": {
    "url": "https://github.com/rlakamraju/angular-material-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-data.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "validate-data": "tsx scripts/validate-data.ts",
    "audit": "npm audit --audit-level=high",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test": "npm run test:unit && npm run build && npm run test:integration",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "angular",
    "angular-material"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "typescript": "^5.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^4.1.10"
  }
}
